# spec-kit-jira team configuration.
#
# This file is COMMITTABLE. It carries no credential: an API token and an email
# address are refused at every key (exit 4). The one host-shaped value it may
# hold is `base_url` below — your team's Jira identifies the team, not you, so
# it belongs in a reviewed file rather than in each developer's shell.
#
# The token never lives in any file. It is read from JIRA_API_TOKEN, or from a
# retrieval command you declare in JIRA_PAT_COMMAND so that an OS vault answers
# for it — see docs/CREDENTIALS.md. Your own email goes in the gitignored
# .specify/jira/personal.yml, and resolved ids in .specify/jira/config.local.yml.
#
# Your team's Jira site. The ceremony does not invent it: until it is set here
# (or SPEC_KIT_JIRA_BASE_URL is exported) every run reports a degraded state
# naming this key. No trailing slash — the sink appends /rest/api/3/... itself.
# base_url: "https://your-site.atlassian.net"

# Keys use business language (what the team decides), not Jira internals. The
# `/speckit.jira.config` command fills the discovered ids into config.local.yml.

# Which Jira project(s) this repository mirrors into.
projects:
  - # The project key (public within your org), e.g. PROJ.
    key: PROJ

    # How the project is managed in Jira: company_managed | team_managed.
    # OPTIONAL — detected from the Jira API at config time and persisted with
    # its provenance in config.local.yml. Declare it here ONLY as an explicit
    # operator answer (e.g. when the API signal is ambiguous); a declaration
    # that conflicts with an unambiguous API signal is refused, never silently
    # overridden.
    # style: team_managed

    # Spec priority (P1/P2/P3) -> your project's priority name.
    priority_map:
      P1: Highest
      P2: Medium
      P3: Low

    # The estimation field to use. Discovered and operator-confirmed at config
    # time (for team-managed projects this is the project's own field, never the
    # global Story Points custom field). Stored by logical descriptor.
    # estimation_field: Story point estimate

    # Which of your project's issue types plays each mirror role, by NAME
    # (never a fixed Jira default — Constitution VII). OPTIONAL when your
    # project offers exactly one non-sub-task issue type at each hierarchy
    # level: the bridge derives specification and story on its own. Declare
    # it here when a level holds several candidates (the config ceremony
    # would otherwise ask, once, with --issue-type) — for example, a project
    # with both Epic and Service Category at the level above Story:
    #   hierarchy:
    #     specification: Epic
    #     story: Story
    #     task: Sub-task
    # `task` is never derived, even when unambiguous: declare it only once
    # your team is ready for sub-task mirroring (a future release). The
    # example above documents the shape only — it is NEVER a fallback; an
    # undeclared, unresolved role refuses at configuration time (zero writes).
    # hierarchy:
    #   specification: Epic
    #   story: Story
    #   task: Sub-task

    # Where each spec-kit lifecycle event should leave a ticket on your
    # board, declared per hierarchy role. OPTIONAL — a project that declares
    # nothing is never moved at all, which is exactly today's behaviour.
    #
    # A value is the DESTINATION STATUS NAME, spelled exactly as your own
    # project spells it: the comparison is exact string equality, and a near
    # miss is reported rather than guessed. A ticket is moved only when
    # exactly ONE of its real available transitions lands on the declared
    # status and is not gated on a field the bridge does not hold; two
    # candidates, a gated one, or none reachable in a single move each
    # withhold the move instead and warn once, naming the ticket and the
    # reason. There is no built-in status table and no assumed ordering —
    # your workflow is authoritative.
    #
    # The lifecycle events are after_specify, after_clarify, after_plan,
    # after_tasks, after_implement and after_analyze; the roles are
    # specification, story and task. Declare one role, two, or all three. A
    # mapping whose keys are all lifecycle events is the STORY role's (the
    # pre-023 shape, still valid); mixing the two key sets in one mapping is
    # refused (exit 4). A `task` mapping applies only where tasks are
    # mirrored as sub-tasks.
    #
    # `/speckit.jira.config` proposes a draft over the statuses discovered in
    # YOUR project and records the answer you confirm. Edit it by hand at any
    # time — the ceremony never rewrites a mapping it finds, and deleting the
    # key restores the no-movement behaviour.
    # phase_status_map:
    #   specification:
    #     after_plan: In Progress
    #   story:
    #     after_specify: To Do
    #     after_implement: In Review
    #   task:
    #     after_implement: Done

    # Statuses that mean "a human has taken this ticket out of the flow".
    # A ticket standing at one is surfaced and left alone: no transition and
    # no content write. Project-wide, never per role.
    # halted_statuses:
    #   - Blocked

# Route each spec folder to a project. First matching rule wins.
routing:
  - match:
      folder_prefix: '' # e.g. 'billing-' matches specs/billing-*
    project: PROJ

# The project used when no routing rule matches.
routing_default: PROJ

# OPTIONAL team catalogue: the naming conventions each team ships under. When a
# developer selects a team in the gitignored .specify/jira/personal.yml, the
# feature ceremony resolves the Jira ticket first and names the branch/folder
# by that team's convention. Without this section (or without a personal
# selection) nothing changes.
#   id            — catalogue team id (lowercase, ^[a-z][a-z0-9]*$), unique.
#   project       — the team's Jira project key.
#   folder_prefix — flat spec-folder prefix (^[a-z0-9][a-z0-9-]*-$), unique.
#   branch_pattern— branch template holding <ID> and <FEATURE_NAME> exactly
#                   once each; other characters restricted to [a-z0-9/_-].
# teams:
#   - id: ijt
#     project: IJT
#     folder_prefix: "ijt-"
#     branch_pattern: "ijt-<ID>/<FEATURE_NAME>"
#   - id: wex
#     project: WEX
#     folder_prefix: "wex-"
#     branch_pattern: "wex-<ID>/<FEATURE_NAME>"

# Privacy allowlist: hosts/domains that never block or warn (e.g. your public
# documentation Confluence host).
privacy:
  allowlist: []

# Values this bridge sends when it CREATES a ticket of the named type — the
# answer to "a mandatory Jira field the bridge cannot supply on its own"
# (011). Written by `/speckit.jira.config`, inside the marker-delimited
# managed region below; edit a value by hand if you like, but keep it
# between the markers — an entry outside them is a duplicate top-level key
# and the next read refuses it (exit 4). Removing an entry stops the bridge
# sending that field on the next creation; if the field is required, the
# pre-existing refusal returns, naming the field and the command that
# records it again.
#
# Only fields Jira marks REQUIRED are ever asked about; an optional
# defaultable field (like the example below) is recorded only through
# `--field-default` or by hand — the ceremony never turns it into a
# question. `ask` (default true) is the per-project switch for whether a
# creation carrying a recorded default pauses for one consolidated
# confirmation before it is sent; set it to `false` once your team has
# settled and wants defaults applied silently.
#
# --- spec-kit-jira:field_defaults:begin ---
# field_defaults:
#   PROJ:
#     ask: true
#     Epic:
#       Business Owner: "Platform Team"
#       Program Increment: "PI-2026-Q3"
#     Story:
#       Team: "Payments"
# --- spec-kit-jira:field_defaults:end ---

# How each project's task list reaches Jira (022): `subtask` creates one
# sub-task per task; `checklist` writes one checklist into each story
# instead. OPTIONAL — absence is a third state, not a default: it keeps
# today's behaviour exactly (one sub-task per task when a `task` role is
# declared above, no task tier otherwise). Written by `/speckit.jira.config`,
# which asks the question once, per project, and never re-asks once a value
# is recorded. Edit a value here by hand if you like — keep it between the
# markers; an entry outside them is a duplicate top-level key and the next
# read refuses it (exit 4).
#
# --- spec-kit-jira:task_mirror:begin ---
# task_mirror:
#   PROJ: checklist
# --- spec-kit-jira:task_mirror:end ---
