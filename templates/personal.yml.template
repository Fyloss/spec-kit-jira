# spec-kit-jira personal team selection (.specify/jira/personal.yml).
#
# This file is YOURS: human-owned, OPTIONAL, and gitignored (the config
# ceremony enforces the .gitignore coverage). No script ever writes it, and no
# workflow requires it — without it the feature ceremony passes through and
# behaves exactly as if the extension were absent.
#
# Like every committed config file it MUST stay credential-free: a token, an
# email, or a real *.atlassian.net host in any value is refused (exit 4).

# The catalogue team you work in — one of the `teams:` ids declared in
# config.yml. An unknown id is a located error listing the valid ids.
# team: ijt

# Exceptional, auditable convention override. Same validation rules as a
# catalogue entry; every feature-creation output reports when it was used.
# override:
#   folder_prefix: "special-"
#   branch_pattern: "special-<ID>/<FEATURE_NAME>"
