{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit-jira/contracts/run-summary.schema.json",
  "title": "Run Summary (--json form)",
  "description": "The machine-readable form of the structured run summary (NFR-5). The DEFAULT output is human-readable prose; this JSON form is the opt-in --json output. Both ports MUST emit byte-identical JSON for identical inputs (Constitution VI, canonical serialisation per research §11).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "counts", "exit_code"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "command": { "enum": ["config", "reconcile", "mention"] },
    "dry_run": { "type": "boolean", "description": "True when produced by a --dry-run twin; the action set MUST equal the real run's (FR-033)." },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "updated", "skipped", "warnings", "errors"],
      "properties": {
        "created": { "type": "integer", "minimum": 0 },
        "updated": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      }
    },
    "effects": {
      "type": "object",
      "description": "The three effects of a /speckit.jira.config run, reported SEPARATELY (FR-054).",
      "additionalProperties": false,
      "properties": {
        "discovery": { "$ref": "#/$defs/effect" },
        "hooks": { "$ref": "#/$defs/effect" },
        "readme": { "$ref": "#/$defs/effect" }
      }
    },
    "drift": {
      "type": "array",
      "description": "Named drift warnings per ticket + divergent field (FR-031).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticket", "field", "classification"],
        "properties": {
          "ticket": { "type": "string" },
          "field": { "type": "string" },
          "classification": { "enum": ["mapped", "post-scope", "halted", "unknown"] },
          "message": { "type": "string" }
        }
      }
    },
    "flags": {
      "type": "array",
      "description": "Tickets carrying Jira's Flagged marker; transitions withheld by default (FR-036).",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "description": "Open blocking links named as info, non-gating (FR-037).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticket", "blocked_by"],
        "properties": {
          "ticket": { "type": "string" },
          "blocked_by": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "hook_health": {
      "type": "object",
      "description": "Hook health checked and reported on every run (FR-047).",
      "additionalProperties": false,
      "required": ["present", "missing", "disabled"],
      "properties": {
        "present": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "disabled": { "type": "array", "items": { "type": "string" } },
        "repair_hint": { "type": "string", "description": "One-command repair instruction when any hook is missing (FR-047)." }
      }
    },
    "mutations": {
      "type": "array",
      "description": "Every mentioned-ticket mutation logged (FR-049).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticket", "action"],
        "properties": {
          "ticket": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "description": "The documented, monotonically escalating exit code (see cli-contract.md)."
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["written", "unchanged", "created", "repaired", "refused", "skipped"] },
        "detail": { "type": "string" }
      }
    }
  }
}
