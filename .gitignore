.serena/

# Worktrees
.claude/worktrees/

# Test/coverage output (kcov, Pester) — anchored to the repo root so the
# tests/coverage/ runner itself stays tracked
/coverage/
coverage.xml
testResults.xml

# Golden "before" captures recorded from the tree at main to prove a change moved
# no byte. Regenerated deterministically by the recording task, never committed:
# a checked-in baseline silently becomes the thing under test.
/.baseline/

# spec-kit-jira: gitignored personal config, secrets, resolved bindings
.specify/jira/config.local.yml
.specify/jira/personal.yml
.specify/jira/.env

# OS
.DS_Store
Thumbs.db

# Headroom
.claude/.headroom_wrap_marker.json
.tokensave/