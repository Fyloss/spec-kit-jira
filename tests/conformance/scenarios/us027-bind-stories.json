      "IJT-12": {"summary": "Refund a captured payment", "description": "Story two body", "status": {"name": "To Do", "statusCategory": {"key": "new"}}, "issuetype": {"id": "10001", "name": "Story"}, "project": {"key": "IJT"}}
    }
