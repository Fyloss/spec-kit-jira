      "ADO-3": { "labels": ["speckit-adopt:003-label-based-adoption:us2"], "parent": "ADO-1" },
      "ADO-4": { "labels": ["speckit-adopt:004-billing-export"] },
      "ADO-50": { "labels": ["speckit-adopt:004-billing-export:us1"], "parent": "ADO-4" },
      "ADO-51": { "labels": ["speckit-adopt:004-billing-export:us1"], "parent": "ADO-4" },
      "ADO-60": { "labels": [] },
      "ADO-61": { "labels": [], "parent": "ADO-60" }
    }
  },
  "fixture": "tests/conformance/fixtures/repo-with-adoption",
  "argv": ["adopt",
           "--bind", "004-billing-export:us1=ADO-50",
           "--bind", "005-audit-trail=ADO-60",
           "--bind", "005-audit-trail:us1=ADO-61",
           "--yes", "--json"],
