{
  "name": "us5-adopt-dry-run",
  "description": "003 US5 (T144): --dry-run then --yes over the SAME state, in one capture. The two reported action sets must be identical, and the dry-run half of the call log must hold zero writes. For adopt this is structural rather than behavioural: the action set IS the prediction, so there is no second code path that could drift (FR-023, SC-003).",
  "mock": {
    "projects": { "ADO": "company" },
    "issues": { "ADO-1": { "labels": ["speckit-adopt:003-label-based-adoption"] },
      "ADO-2": { "labels": ["speckit-adopt:003-label-based-adoption:us1"], "parent": "ADO-1" },
      "ADO-3": { "labels": ["speckit-adopt:003-label-based-adoption:us2"], "parent": "ADO-1" },
      "ADO-4": { "labels": ["speckit-adopt:004-billing-export"] },
      "ADO-5": { "labels": ["speckit-adopt:004-billing-export:us1"], "parent": "ADO-4" },
      "ADO-6": { "labels": ["speckit-adopt:005-audit-trail"] },
      "ADO-7": { "labels": ["speckit-adopt:005-audit-trail:us1"], "parent": "ADO-6" } }
  },
  "fixture": "tests/conformance/fixtures/repo-with-adoption",
  "env": {
    "JIRA_EMAIL": "user@example.com",
    "JIRA_API_TOKEN": "RAWSECRETXYZ",
    "JIRA_NO_SLEEP": "1",
    "SPEC_KIT_JIRA_REPO": "acme/app"
  },
  "steps": [
    { "argv": ["adopt", "--dry-run", "--json"] },
    { "argv": ["adopt", "--yes", "--json"] }
  ]
}
